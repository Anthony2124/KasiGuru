rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin role is enforced by a Firebase custom claim (`admin == true`).
    // Claims are set via the bootstrapAdmin Cloud Function (see /functions).
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Verifiers moderate everything an admin does except APK releases and blocking users (they
    // flag a user in user_flags instead), and see only verifiers' activity-log entries. An admin
    // adds them by email in the portal's Team page (admin_staff/{lower-case email}), so no script
    // or service-account key is needed; the email must be verified (Google sign-in always is).
    // Costs one document read, and only on requests an admin claim has not already allowed.
    function staffDoc() {
      return /databases/$(database)/documents/admin_staff/$(request.auth.token.email.lower());
    }

    function isVerifier() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && exists(staffDoc())
        && get(staffDoc()).data.role == 'verifier'
        // An invite still waiting for its one-time code grants nothing yet. Entries from before
        // invite codes have no `pending` field and keep their access.
        && get(staffDoc()).data.get('pending', false) != true;
    }

    function isStaff() {
      return isAdmin() || isVerifier();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A counter that is a non-negative int within a range no real player exceeds.
    function isSaneCounter(value, max) {
      return value is int && value >= 0 && value <= max;
    }

    // ---------------------------------------------------------------------------
    // Bounds, sized against the actual game rather than against int limits.
    //
    // Constants.LEVEL_THRESHOLDS tops out at level 10 / 5,000 XP, so the previous
    // ceilings (100,000,000 XP, level 1,000) were four to five orders of magnitude
    // above anything reachable and gave a forged write almost unlimited room.
    //
    // MAX_* keeps generous headroom over a real player so a future level-cap raise
    // does not silently start rejecting honest syncs. FIRST_WRITE_MAX_XP is the one
    // that matters for anti-cheat: see the note on isFirstWrite below.
    // ---------------------------------------------------------------------------
    function maxXp()          { return 1000000; }   // 200x the level-10 threshold
    function maxLevel()       { return 100; }       // 10x the current level cap
    function maxStreak()      { return 3650; }      // ten years of daily play
    function maxWords()       { return 100000; }    // ~250x the current dictionary

    // The ceiling for a write that has no prior document to diff against.
    //
    // Both delta-capped validators below exempt their first write, because there is
    // genuinely nothing to compare to. That exemption was unbounded, and delete is
    // (necessarily) allowed on both documents — so "delete your own row, then create
    // it fresh" reset the cap and let a single create mint the maximum value. Two
    // writes, no tooling beyond the SDK.
    //
    // Closing the exemption entirely would break a real flow: XP accrues locally in
    // Room whether or not anyone is signed in, so a player's genuine first sync can
    // legitimately carry a large accumulated total. 100,000 XP is twenty times the
    // level-10 threshold — comfortably above any honest first sync, and 1,000x below
    // what the old rule allowed a forged one to claim.
    function firstWriteMaxXp() { return 100000; }

    // users/{uid}/progress/main — the headline stats the leaderboard is built from.
    // This is the authoritative document the sync merge (`maxOf(local, remote)`) treats
    // as a floor that can never decrease — so unlike a display-only field, a single
    // fabricated write here becomes permanent. Delta-capped the same way
    // isValidLeaderboardEntry() already is, using the same +2000 XP/write bound that
    // function already judged sufficient headroom for a debounced multi-action sync
    // burst (a mini-game finish plus one or two achievement unlocks, worst case).
    function isValidMainProgress() {
      let d = request.resource.data;
      let isFirstWrite = resource == null;
      // Mirrors ProgressSyncManager.toMap() exactly. `password` is deliberately absent
      // there and must stay absent here. Adding a field to the entity means touching
      // toMap, toEntity, mergeProgress AND this list — the same parity
      // ProgressSyncFieldParityTest already guards on the Kotlin side.
      //
      // hasOnly() rejects the WHOLE document when it carries a key this list omits, and a
      // rejected write is only a warning in the client log — so a field added to toMap()
      // without being added here does not degrade sync, it silently stops the main progress
      // document from ever being written again. That is exactly what happened to the three
      // daily-quota fields below: streaks and daily requirements stopped reaching the cloud,
      // and signing out (which clears local data) then back in restored a stale document.
      // MainProgressRulesParityTest now fails the build on this mismatch.
      return d.keys().hasOnly([
        'id', 'userName', 'email', 'fullName', 'age', 'address', 'profileIconId',
        'totalXp', 'level', 'currentStreak', 'longestStreak', 'lastActiveDate',
        'wordsLearned', 'storiesCompleted', 'gamesPlayed', 'totalCorrectAnswers',
        'totalQuestionsAnswered', 'lessonsCompleted', 'isOnboardingCompleted',
        'dailyGoalXp', 'dailyXpEarned', 'dailyXpDate', 'titleBadge', 'submissionsMade',
        'dailyReviewCompletedDate', 'dailyGamesDate', 'dailyGamesPlayedCount',
        'updatedAt', 'xpPolicyVersion', 'activityXp', 'badgeBonusXp', 'pinnedBadgeIds', 'profileBackgroundId'
      ])
        && isSaneCounter(d.totalXp, maxXp())
        && isSaneCounter(d.level, maxLevel())
        && isSaneCounter(d.currentStreak, maxStreak())
        && isSaneCounter(d.longestStreak, maxStreak())
        && isSaneCounter(d.wordsLearned, maxWords())
        && isSaneCounter(d.get('xpPolicyVersion', 0), 2)
        && (!('activityXp' in d) || isSaneCounter(d.activityXp, maxXp()))
        && (!('badgeBonusXp' in d) || isSaneCounter(d.badgeBonusXp, 6200))
        && (!('profileBackgroundId' in d) || d.profileBackgroundId in ['forest','casapsapan','farm','river','ermita_hill','ontok_lighthouse','tibu_tidal_pool'])
        && (!('pinnedBadgeIds' in d) || d.pinnedBadgeIds is string && d.pinnedBadgeIds.size() <= 128)
        && (isFirstWrite || d.get('xpPolicyVersion', 0) >= resource.data.get('xpPolicyVersion', 0))
        && (d.get('xpPolicyVersion', 0) != 2 ||
            (d.level <= 30 && d.totalXp == d.activityXp + d.badgeBonusXp))
        && (!('userName' in d) || d.userName is string && d.userName.size() <= 100)
        && (!('fullName' in d) || d.fullName is string && d.fullName.size() <= 100)
        && (!('titleBadge' in d) || d.titleBadge is string && d.titleBadge.size() <= 100)
        && (!('lastActiveDate' in d) || d.lastActiveDate is string && d.lastActiveDate.size() <= 20)
        // The daily streak quota: which ISO day the "review words" task was cleared on, and
        // how many mini-game levels were finished on the day the counter belongs to. Bounded
        // like every other counter rather than delta-capped — the count resets each day, so a
        // day-over-day diff is meaningless, and an inflated value buys nothing beyond one
        // day's streak tick that isValidMainProgress already caps at +1 per write.
        && (!('dailyReviewCompletedDate' in d) || d.dailyReviewCompletedDate is string && d.dailyReviewCompletedDate.size() <= 20)
        && (!('dailyGamesDate' in d) || d.dailyGamesDate is string && d.dailyGamesDate.size() <= 20)
        && (!('dailyGamesPlayedCount' in d) || isSaneCounter(d.dailyGamesPlayedCount, 1000))
        && (!('updatedAt' in d) || d.updatedAt is int)
        // A first write is bounded rather than exempt — otherwise delete-then-create
        // resets every delta cap below. The other counters are already held by their
        // isSaneCounter bounds above; XP is the one that needs its own first-write
        // ceiling. See firstWriteMaxXp().
        && (!isFirstWrite || d.totalXp <= firstWriteMaxXp())
        && (isFirstWrite || (d.get('xpPolicyVersion', 0) == 2 && resource.data.get('xpPolicyVersion', 0) < 2)
            || (d.totalXp - resource.data.totalXp) <= 2000)
        && (isFirstWrite || (d.currentStreak - resource.data.currentStreak) <= 1)
        && (isFirstWrite || (d.wordsLearned - resource.data.wordsLearned) <= 50)
        // level and longestStreak were range-checked but never delta-capped, so they
        // could be pinned to the ceiling in one write. main progress is the floor the
        // sync merge treats as permanent (maxOf(local, remote)), so that stuck.
        && (isFirstWrite || (d.get('xpPolicyVersion', 0) == 2 && resource.data.get('xpPolicyVersion', 0) < 2)
            || (d.level - resource.data.level) <= 5)
        && (isFirstWrite || (d.longestStreak - resource.data.longestStreak) <= 1);
    }

    // The achievements / gameLevels / lessonProgress / wordStates documents: a bounded entries map.
    function isValidLearningDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['entries', 'updatedAt'])
        && d.entries is map
        && d.entries.size() <= 5000
        && d.updatedAt is int;
    }

    function isValidProgressDoc(docId) {
      return docId == 'main'
        ? isValidMainProgress()
        : (docId in ['achievements', 'gameLevels', 'lessonProgress', 'wordStates'] && isValidLearningDoc());
    }

    // leaderboard_public/{uid} — published by the client itself (free/Spark plan:
    // no Cloud Function to do it server-side). XP is therefore still ultimately
    // client-trusted, but this bounds the damage: a single write can only raise
    // totalXp by 2000 over its previous value, so a compromised/buggy client
    // can't mint a #1 rank in one shot. Not cryptographic anti-cheat — real
    // anti-cheat would need XP computed server-side.
    function isValidLeaderboardEntry() {
      let d = request.resource.data;
      // No prior row (first publish, e.g. an existing player's first sync after this
      // feature shipped) has nothing to diff against, so the per-write delta cap cannot
      // apply — rejecting it outright would hide real players forever. It is bounded by
      // an absolute ceiling instead of exempted; an exemption was the delete-and-recreate
      // hole. See firstWriteMaxXp().
      let isFirstPublish = resource == null;
      return d.keys().hasOnly([
        'displayName', 'totalXp', 'level', 'currentStreak', 'profileIconId',
        'titleBadge', 'weeklyXp', 'weekStartXp', 'weekStartDate', 'updatedAt',
        'isAnonymous', 'createdAt', 'registeredAt', 'xpPolicyVersion', 'activityXp'
      ])
        && d.displayName is string && d.displayName.size() <= 40
        && isSaneCounter(d.totalXp, maxXp())
        && isSaneCounter(d.level, maxLevel())
        && isSaneCounter(d.currentStreak, maxStreak())
        && isSaneCounter(d.profileIconId, 1000)
        && d.titleBadge is string && d.titleBadge.size() <= 100
        && isSaneCounter(d.weeklyXp, maxXp())
        && isSaneCounter(d.weekStartXp, maxXp())
        && d.weekStartDate is string && d.weekStartDate.size() <= 20
        && d.updatedAt is int
        && isSaneCounter(d.get('xpPolicyVersion', 0), 2)
        && (!('activityXp' in d) || isSaneCounter(d.activityXp, maxXp()))
        && (isFirstPublish || d.get('xpPolicyVersion', 0) >= resource.data.get('xpPolicyVersion', 0))
        && (d.get('xpPolicyVersion', 0) != 2 || (d.level <= 30 && d.weeklyXp <= d.activityXp))
        && (!('isAnonymous' in d) || d.isAnonymous is bool)
        && (!('createdAt' in d) || d.createdAt is int)
        && (!('registeredAt' in d) || d.registeredAt is int || (d.registeredAt is string && d.registeredAt.size() <= 30))
        // Bounded, not exempt: deleting your own row and re-creating it used to reset
        // every cap below and mint rank #1 in two writes. See firstWriteMaxXp().
        && (!isFirstPublish || (d.totalXp <= firstWriteMaxXp() && d.weeklyXp <= firstWriteMaxXp()))
        && (isFirstPublish || (d.get('xpPolicyVersion', 0) == 2 && resource.data.get('xpPolicyVersion', 0) < 2)
            || (d.totalXp - resource.data.totalXp) <= 2000)
        // Same reasoning as the totalXp cap above: streak legitimately moves by exactly
        // 1 per day, and a 2000 XP burst can cross a handful of level thresholds at
        // once but never hundreds.
        && (isFirstPublish || (d.currentStreak - resource.data.currentStreak) <= 1)
        && (isFirstPublish || (d.get('xpPolicyVersion', 0) == 2 && resource.data.get('xpPolicyVersion', 0) < 2)
            || (d.level - resource.data.level) <= 5);
    }

    function isValidRewardReceipt() {
      let d = request.resource.data;
      return d.keys().hasOnly(['policyVersion','id','kind','source','day','xp','value','imported','updatedAt'])
        && d.policyVersion == 2
        && d.id is string && d.id.size() > 0 && d.id.size() <= 512
        && d.source is string && d.source.size() > 0 && d.source.size() <= 256
        && d.day is string && (d.day.size() == 0 || d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && d.kind in ['lesson','game','replay','review','story','mastery','approved','badge','perfect','retrieval','category','access']
        && isSaneCounter(d.xp, 200) && isSaneCounter(d.value, 1) && d.imported is bool
        && d.updatedAt == request.time
        && (resource == null || (d.id == resource.data.id && d.kind == resource.data.kind &&
            d.source == resource.data.source && d.xp >= resource.data.xp &&
            d.value >= resource.data.value && (!resource.data.imported || d.imported)));
    }

    // Allowed fields and size limits for community word submissions.
    // The Android app writes these anonymously (the app has no auth), so
    // create is open to everyone but every field is validated.
    function isValidSubmission() {
      let data = request.resource.data;
      let allowedKeys = data.keys().hasOnly([
        'id', 'kasiguranin', 'tagalog', 'english', 'rootForm', 'category', 'partOfSpeech',
        'ipaNotation', 'exampleSentence', 'pastTense', 'presentTense', 'futureTense', 'contributorName', 'status', 'submittedAt', 'uid'
      ]);
      return allowedKeys
        && data.kasiguranin is string
        && data.kasiguranin.size() >= 1
        && data.kasiguranin.size() <= 80
        && data.tagalog is string && data.tagalog.size() <= 300
        && data.english is string && data.english.size() <= 300
        && data.rootForm is string && data.rootForm.size() <= 80
        && data.category is string && data.category.size() <= 60
        && data.partOfSpeech is string && data.partOfSpeech.size() <= 50
        && data.ipaNotation is string && data.ipaNotation.size() <= 120
        && data.exampleSentence is string && data.exampleSentence.size() <= 500
        && data.pastTense is string && data.pastTense.size() <= 100
        && data.presentTense is string && data.presentTense.size() <= 100
        && data.futureTense is string && data.futureTense.size() <= 100
        && data.contributorName is string && data.contributorName.size() <= 60
        && data.status == 'pending'
        && data.submittedAt is int
        && data.uid is string && data.uid.size() <= 128
        && (!('id' in data) || data.id == request.resource.id);
    }

    // An example sentence a learner offers for a word that has none. It identifies the word by its
    // sense (headword + English gloss), since Room ids are not Firestore ids. Pending until a
    // verifier approves it, which writes it onto the vocabulary document.
    function isValidSentenceSubmission() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'id', 'kasiguranin', 'english', 'sentence', 'translation', 'contributorName', 'status', 'submittedAt', 'uid'
        ])
        && data.kasiguranin is string && data.kasiguranin.size() >= 1 && data.kasiguranin.size() <= 80
        && data.english is string && data.english.size() <= 300
        && data.sentence is string && data.sentence.size() >= 5 && data.sentence.size() <= 300
        && data.translation is string && data.translation.size() >= 2 && data.translation.size() <= 300
        && data.contributorName is string && data.contributorName.size() <= 60
        && data.status == 'pending'
        && data.submittedAt is int
        && data.uid is string
        && (data.uid == '' || (isSignedIn() && data.uid == request.auth.uid))
        && (!('id' in data) || data.id == request.resource.id);
    }

    match /sentence_submissions/{docId} {
      allow create: if isValidSentenceSubmission();
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) || isStaff();
      allow update, delete: if isStaff();
    }

    // ---------------------------------------------------------------------------
    // Master dictionary: public read (app + admin), admin-only writes.
    // Seeding is intentionally admin-only; clients must NOT push seed data.
    // ---------------------------------------------------------------------------
    match /vocabulary/{docId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // Stories: public read, admin-only writes.
    match /stories/{docId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // Story page illustrations, one document per picture, keyed {storyId}_{imageId}.
    //
    // They live outside the story document on purpose. All of a story's pages share one `pagesJson`
    // string field, and the app pulls the entire stories collection on every sync -- so an embedded
    // picture would both push the document toward Firestore's 1 MiB ceiling and make every learner
    // download every picture of every story. Here the reader fetches one page's image at a time.
    //
    // The size guard is deliberate: the admin writes 1440x1440 WebP at roughly 150 KB, and without a
    // ceiling a mis-encoded upload would fail against the 1 MiB document limit with nothing but a raw
    // Firestore error to explain it.
    match /story_page_images/{docId} {
      allow read: if true;
      allow create, update: if isStaff()
                            && request.resource.data.data is bytes
                            && request.resource.data.data.size() < 400 * 1024;
      allow delete: if isStaff();
    }

    // Word pronunciation clips, one document per sense, keyed slug(kasiguranin)__slug(english).
    //
    // Same reasoning as story_page_images: no Firebase Storage on the Spark plan, so a short voice
    // recording lives here as raw bytes rather than in the vocabulary document — which the app pulls
    // in bulk on every reconcile — and WordAudioRepository fetches one at a time on first play. The
    // vocabulary doc carries only a pointer (audioResName) and audioUpdatedAt. The size guard keeps
    // a mis-exported upload from failing against the 1 MiB document ceiling with a raw Firestore
    // error; an already-compressed m4a/mp3/ogg clip of a single word is tens of KB.
    match /word_audio/{docId} {
      allow read: if true;
      allow create, update: if isStaff()
                            && request.resource.data.data is bytes
                            && request.resource.data.data.size() < 400 * 1024;
      allow delete: if isStaff();
    }

    // System announcements: public read, admin-only writes. Read live by AnnouncementRepository
    // (a callbackFlow, same shape as leaderboard_public) while the app is open. There is no
    // Cloud Function watching this for a push - Spark plan sends are a local script
    // (functions/send_push.js) run by hand, same limitation the release pipeline already has.
    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // App releases: public read (download page + in-app update), admin-only writes.
    match /app_releases/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Community submissions: anonymous create (validated), admin-only everything else.
    // Anonymous delete/update is denied so pending queue items cannot be tampered with.
    match /word_submissions/{docId} {
      allow create: if isValidSubmission();
      // A submitter may read their own submissions back (needed for the "Trusted Voice" /
      // "Corpus Builder" badges, which count a user's own approved submissions) but never
      // anyone else's; only an admin can read the whole queue. Still owner-only: this does not
      // let a submitter read who else submitted what.
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) || isStaff();
      allow update, delete: if isStaff();
    }

    // Community story/poem submissions - full literature, not a single word. Same shape as
    // isValidSubmission(): create is open (the app has no auth), everything else admin-only.
    // Submissions are text-only, no illustrations - Adrian authors all artwork himself, and any
    // art for an approved piece is added afterward through the existing story-authoring flow -
    // so pagesJson at plain text volumes is nowhere near Firestore's 1 MiB document ceiling even
    // at the 40-page cap the app enforces client-side.
    function isValidLiteratureSubmission() {
      let data = request.resource.data;
      let allowedKeys = data.keys().hasOnly([
        'id', 'title', 'titleKasiguranin', 'pagesJson', 'contributorName', 'pdfBase64', 'pdfFileName', 'status', 'submittedAt', 'uid'
      ]);
      return allowedKeys
        && data.title is string && data.title.size() <= 200
        && data.titleKasiguranin is string && data.titleKasiguranin.size() <= 200
        && (data.title.size() >= 1 || data.titleKasiguranin.size() >= 1)
        && data.pagesJson is string && data.pagesJson.size() <= 300000
        && data.contributorName is string && data.contributorName.size() <= 60
        && data.pdfBase64 is string && data.pdfBase64.size() >= 20 && data.pdfBase64.size() <= 800000
        && (!('pdfFileName' in data) || data.pdfFileName is string && data.pdfFileName.size() <= 255)
        && data.status == 'pending'
        && data.submittedAt is int
        && data.uid is string && data.uid.size() <= 128
        && (!('id' in data) || data.id == request.resource.id);
    }

    match /literature_submissions/{docId} {
      allow create: if isValidLiteratureSubmission();
      // Same owner-read exception as word_submissions, for the same badge-counting reason.
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) || isStaff();
      allow update, delete: if isStaff();
    }

    // User-submitted issue & bug reports (system glitches, wrong word corrections, with photo evidence).
    function isValidIssueReport() {
      let data = request.resource.data;
      let allowedKeys = data.keys().hasOnly([
        'id', 'category', 'title', 'description', 'targetWord', 'targetScreen',
        'photoBase64', 'photoUrl', 'reporterName', 'reporterEmail', 'appVersion',
        'deviceInfo', 'status', 'adminNotes', 'submittedAt', 'uid'
      ]);
      return allowedKeys
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 250
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 5000
        && (!('targetWord' in data) || data.targetWord is string && data.targetWord.size() <= 150)
        && (!('targetScreen' in data) || data.targetScreen is string && data.targetScreen.size() <= 100)
        && (!('photoBase64' in data) || data.photoBase64 is string && data.photoBase64.size() <= 700000)
        && (!('photoUrl' in data) || data.photoUrl is string && data.photoUrl.size() <= 2000)
        && (!('reporterName' in data) || data.reporterName is string && data.reporterName.size() <= 100)
        && (!('reporterEmail' in data) || data.reporterEmail is string && data.reporterEmail.size() <= 150)
        && (!('appVersion' in data) || data.appVersion is string && data.appVersion.size() <= 100)
        && (!('deviceInfo' in data) || data.deviceInfo is string && data.deviceInfo.size() <= 200)
        && data.status == 'pending'
        && (!('adminNotes' in data) || data.adminNotes is string && data.adminNotes.size() <= 2000)
        && data.submittedAt is int
        && data.uid is string && data.uid.size() <= 128
        && (!('id' in data) || data.id == request.resource.id);
    }

    match /issue_reports/{docId} {
      allow create: if isValidIssueReport();
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) || isStaff();
      allow update, delete: if isStaff();
    }

    // Admin audit log: append-only. Admins read every entry; a verifier reads only verifiers'
    // entries, so the portal's verifier queries ask for actorRole == 'verifier' (rules are not
    // filters - an unfiltered query from a verifier is refused whole). Entries from before roles
    // were recorded carry no actorRole and were all made by admins.
    match /admin_audit_log/{docId} {
      allow read: if isAdmin()
        || (isVerifier() && resource.data.actorRole == 'verifier');
      // A verifier logs only as themselves and as a verifier, so the role shown on an entry and the
      // admin/verifier split above cannot be forged from a verifier's session.
      allow create: if isAdmin()
        || (isVerifier()
          && request.resource.data.actorRole == 'verifier'
          && request.resource.data.actor is string
          && request.resource.data.actor.lower() == request.auth.token.email.lower());
      allow update, delete: if false;
    }

    // The portal's verifiers, one document per lower-case email: { role: 'verifier', email,
    // addedBy, addedAt }, plus { pending, attempts, tried, codeExpiresAt } while an invite waits for
    // its one-time code. Admins manage the list; a verifier may read only their own entry, which is
    // how the portal learns their role at sign-in.
    function isInvitee(email) {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
    }

    function inviteCode(email) {
      return get(/databases/$(database)/documents/admin_staff_codes/$(email)).data;
    }

    match /admin_staff/{email} {
      allow read: if isAdmin() || isInvitee(email);
      allow create, update: if isAdmin()
        && request.resource.data.role == 'verifier'
        && request.resource.data.email == email
        && email == email.lower();
      // A verifier stamps when they last signed in, for the Team page, and may change nothing else.
      allow update: if isVerifier()
        && request.auth.token.email.lower() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
        && request.resource.data.lastSeenAt is int;
      // An invitee first records a try at their code, at most five per code. A wrong guess is
      // therefore counted, which it could not be if the try and the check were one write: a denied
      // write leaves no trace.
      allow update: if isInvitee(email)
        && resource.data.get('pending', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts', 'tried'])
        && request.resource.data.attempts == resource.data.get('attempts', 0) + 1
        && request.resource.data.attempts <= 5
        && request.resource.data.tried is string
        && request.resource.data.tried.matches('[0-9]{6}');
      // Then the invite opens only if the try on record is the current, unexpired code.
      allow update: if isInvitee(email)
        && resource.data.get('pending', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending', 'activatedAt', 'lastSeenAt'])
        && request.resource.data.pending == false
        && request.resource.data.activatedAt is int
        && request.resource.data.get('lastSeenAt', 0) is int
        && resource.data.get('tried', '') == inviteCode(email).code
        && request.time.toMillis() < inviteCode(email).expiresAt;
      allow delete: if isAdmin();
    }

    // The one-time codes themselves, kept apart from admin_staff because an invitee can read their
    // own entry there. Only admins ever read them; the rules above compare against them.
    match /admin_staff_codes/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.code is string
        && request.resource.data.code.matches('[0-9]{6}')
        && request.resource.data.expiresAt is int;
    }

    // Per-user cloud data (cross-device progress sync).
    // Owner-only access; admins can read for dashboard verification.
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isOwner(userId);
    }

    // A lightweight identity hint, not a secret: owner-only, exactly like users/{userId}. Never
    // readable pre-authentication - see AuthRepository.saveSecurityQuestions for why this is not
    // wired into password reset as a pre-auth gate.
    match /security_questions/{userId} {
      allow read, write: if isOwner(userId);
    }

    // The synced progress documents. Validated so a compromised or buggy client
    // cannot store absurd counters (which the leaderboard function reads) or an
    // unbounded blob. Deletes stay allowed so a user can clear their own data.
    match /users/{userId}/progress/{docId} {
      allow read: if isOwner(userId) || isStaff();
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProgressDoc(docId);
    }

    match /users/{userId}/rewardReceipts/{receiptId} {
      allow read: if isOwner(userId) || isStaff();
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidRewardReceipt();
    }

    // Any other per-user subcollection stays owner-only (no schema assumptions).
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if isOwner(userId) && collection != 'progress' && collection != 'rewardReceipts';
    }

    // Public leaderboard rows. Readable by any signed-in client so the app can
    // rank real players. Writable only by the row's own owner, and only within
    // the bounds of isValidLeaderboardEntry (see above) — free-plan tradeoff,
    // see that function's comment.
    function validPublicSectionCounts(stats) {
      return stats is map && stats.keys().hasOnly(['pagbati', 'pamilya', 'tahanan', 'pagkain', 'paglalakbay', 'katawan', 'kalikasan', 'hayop', 'bilang', 'kabuhayan', 'kilos', 'paglalarawan', 'araw_araw'])
        && (!('pagbati' in stats) || isSaneCounter(stats.pagbati, 500))
        && (!('pamilya' in stats) || isSaneCounter(stats.pamilya, 500))
        && (!('tahanan' in stats) || isSaneCounter(stats.tahanan, 500))
        && (!('pagkain' in stats) || isSaneCounter(stats.pagkain, 500))
        && (!('paglalakbay' in stats) || isSaneCounter(stats.paglalakbay, 500))
        && (!('katawan' in stats) || isSaneCounter(stats.katawan, 500))
        && (!('kalikasan' in stats) || isSaneCounter(stats.kalikasan, 500))
        && (!('hayop' in stats) || isSaneCounter(stats.hayop, 500))
        && (!('bilang' in stats) || isSaneCounter(stats.bilang, 500))
        && (!('kabuhayan' in stats) || isSaneCounter(stats.kabuhayan, 500))
        && (!('kilos' in stats) || isSaneCounter(stats.kilos, 500))
        && (!('paglalarawan' in stats) || isSaneCounter(stats.paglalarawan, 500))
        && (!('araw_araw' in stats) || isSaneCounter(stats.araw_araw, 500));
    }

    function validPublicProfile() {
      let d = request.resource.data;
      return d.keys().hasAll(['displayName','profileIconId','profileBackgroundId','level','totalXp','currentStreak',
          'wordsLearned','lessonsCompleted','weeklyXp','weekId','createdAt','updatedAt','badgeIds',
          'sections','sectionTotals','masteredSections','unlockedSections'])
        && d.keys().hasOnly(['displayName','profileIconId','profileBackgroundId','level','totalXp','currentStreak',
          'wordsLearned','lessonsCompleted','weeklyXp','weekId','createdAt','updatedAt','badgeIds',
          'sections','sectionTotals','masteredSections','unlockedSections'])
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40
        && isSaneCounter(d.profileIconId, 1000)
        && d.profileBackgroundId in ['forest','casapsapan','farm','river','ermita_hill','ontok_lighthouse','tibu_tidal_pool']
        && isSaneCounter(d.level, 30) && d.level >= 1
        && isSaneCounter(d.totalXp, maxXp()) && isSaneCounter(d.currentStreak, maxStreak())
        && isSaneCounter(d.wordsLearned, maxWords()) && isSaneCounter(d.lessonsCompleted, 5000)
        && isSaneCounter(d.weeklyXp, maxXp())
        && d.weekId is string && d.weekId.size() <= 20 && d.createdAt is int && d.updatedAt is int
        && d.badgeIds is list && d.badgeIds.size() <= 66 && d.badgeIds.hasOnly([
          'badge:word_explorer:1', 'badge:word_explorer:2', 'badge:word_explorer:3', 'badge:word_explorer:4', 'badge:word_explorer:5', 'badge:word_explorer:6',
          'badge:lesson_pathfinder:1', 'badge:lesson_pathfinder:2', 'badge:lesson_pathfinder:3', 'badge:lesson_pathfinder:4', 'badge:lesson_pathfinder:5', 'badge:lesson_pathfinder:6',
          'badge:review_keeper:1', 'badge:review_keeper:2', 'badge:review_keeper:3', 'badge:review_keeper:4', 'badge:review_keeper:5', 'badge:review_keeper:6',
          'badge:consistent_learner:1', 'badge:consistent_learner:2', 'badge:consistent_learner:3', 'badge:consistent_learner:4', 'badge:consistent_learner:5', 'badge:consistent_learner:6',
          'badge:game_adventurer:1', 'badge:game_adventurer:2', 'badge:game_adventurer:3', 'badge:game_adventurer:4', 'badge:game_adventurer:5', 'badge:game_adventurer:6',
          'badge:precision_player:1', 'badge:precision_player:2', 'badge:precision_player:3', 'badge:precision_player:4', 'badge:precision_player:5', 'badge:precision_player:6',
          'badge:mode_explorer:1', 'badge:mode_explorer:2', 'badge:mode_explorer:3', 'badge:mode_explorer:4', 'badge:mode_explorer:5', 'badge:mode_explorer:6',
          'badge:story_reader:1', 'badge:story_reader:2', 'badge:story_reader:3', 'badge:story_reader:4', 'badge:story_reader:5', 'badge:story_reader:6',
          'badge:category_scholar:1', 'badge:category_scholar:2', 'badge:category_scholar:3', 'badge:category_scholar:4', 'badge:category_scholar:5', 'badge:category_scholar:6',
          'badge:community_contributor:1', 'badge:community_contributor:2', 'badge:community_contributor:3', 'badge:community_contributor:4', 'badge:community_contributor:5', 'badge:community_contributor:6',
          'badge:journey_rank:1', 'badge:journey_rank:2', 'badge:journey_rank:3', 'badge:journey_rank:4', 'badge:journey_rank:5', 'badge:journey_rank:6'])
        && validPublicSectionCounts(d.sections) && validPublicSectionCounts(d.sectionTotals)
        && d.masteredSections is list && d.masteredSections.size() <= 13 && d.masteredSections.hasOnly(['pagbati', 'pamilya', 'tahanan', 'pagkain', 'paglalakbay', 'katawan', 'kalikasan', 'hayop', 'bilang', 'kabuhayan', 'kilos', 'paglalarawan', 'araw_araw'])
        && d.unlockedSections is list && d.unlockedSections.size() <= 13 && d.unlockedSections.hasOnly(['pagbati', 'pamilya', 'tahanan', 'pagkain', 'paglalakbay', 'katawan', 'kalikasan', 'hayop', 'bilang', 'kabuhayan', 'kilos', 'paglalarawan', 'araw_araw']);
    }

    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && validPublicProfile();
      allow delete: if isOwner(userId);
    }

    match /leaderboard_public/{userId} {
      allow read: if isSignedIn();
      // Guests (anonymous sessions) are not ranked: only a real account may publish a row.
      // This also stops app versions from before that rule re-adding guest rows.
      allow create, update: if isOwner(userId)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && isValidLeaderboardEntry();
      // Split from create/update: isValidLeaderboardEntry() reads request.resource.data,
      // which is null on a delete — under the old combined `allow write` rule, deleting
      // your own row was silently rejected, which would have broken account deletion.
      allow delete: if isOwner(userId);
    }

    // FCM device tokens (Phase 5): each user manages only their own token doc.
    match /device_tokens/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Validation for suspended users submitting an appeal.
    // The user cannot unban themselves, tamper with ban reasons/timestamps,
    // or forge review decisions, but can submit an appeal statement.
    function isValidBanAppealUpdate() {
      let r = resource.data;
      let nr = request.resource.data;
      return r.isBanned == true
        && nr.isBanned == true
        && nr.reason == r.reason
        && nr.bannedAt == r.bannedAt
        && (!('bannedBy' in r) || nr.bannedBy == r.bannedBy)
        && nr.appealText is string
        && nr.appealText.size() >= 5
        && nr.appealText.size() <= 2000
        && nr.appealStatus == 'pending'
        && nr.appealSubmittedAt is int
        && (!('appealReviewNotes' in r) || nr.appealReviewNotes == r.appealReviewNotes)
        && (!('appealReviewedAt' in r) || nr.appealReviewedAt == r.appealReviewedAt)
        && (!('appealReviewNotes' in nr) || ('appealReviewNotes' in r));
    }

    // User ban records. Written by admins (block/unblock); the banned user's own
    // app can read its own document to show the "Account Suspended" screen without
    // needing a Cloud Function. Users may submit appeals by updating appeal fields.
    // No one else can read or write bans:
    //   - Other users cannot enumerate who is banned.
    //   - Banned users cannot delete their own ban record (admin-only delete).
    match /user_bans/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && isValidBanAppealUpdate());
    }

    // A verifier's request for an admin to look at a learner, one open flag per user:
    // { uid, displayName, reason, flaggedBy, flaggedAt }. Blocking stays an admin's decision, so a
    // verifier can only raise a flag, in their own name, and never change or clear one; an admin
    // clears it by dismissing it or by blocking the user. The learner never sees it.
    match /user_flags/{userId} {
      allow read: if isStaff();
      allow create: if isAdmin()
        || (isVerifier()
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'reason', 'flaggedBy', 'flaggedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 200
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 500
          && request.resource.data.flaggedBy is string
          && request.resource.data.flaggedBy.lower() == request.auth.token.email.lower()
          && request.resource.data.flaggedAt is int);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Deny everything else by default (explicit allow rules only).
  }
}
