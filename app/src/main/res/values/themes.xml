<resources>
    <!-- Base application theme — pure Compose app, XML theme is minimal wrapper -->
    <style name="Theme.KasiGuru" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/night</item>
    </style>

    <!-- Splash screen theme — extends SplashScreen from core-splashscreen library -->
    <style name="Theme.KasiGuru.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.KasiGuru</item>
    </style>
</resources>
