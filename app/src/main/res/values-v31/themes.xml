<resources>
    <!-- Android 12+ draws the splash itself. Same splash as values/themes.xml, plus the KasiGuru wordmark
         as the branding image at the bottom (the platform allows up to 200 x 80 dp). -->
    <style name="Theme.KasiGuru.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/kasiguru_wordmark</item>
        <item name="postSplashScreenTheme">@style/Theme.KasiGuru</item>
    </style>
</resources>
