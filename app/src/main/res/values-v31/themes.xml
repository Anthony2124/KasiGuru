<resources>
    <!-- Android 12+ draws the splash itself. Same plain brand-green splash as values/themes.xml:
         no icon and no branding image, so nothing sits on the green. -->
    <style name="Theme.KasiGuru.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_lime</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_lime</item>
        <item name="postSplashScreenTheme">@style/Theme.KasiGuru</item>
    </style>
</resources>
